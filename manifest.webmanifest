{
  "id": "./",
  "name": "Sunar - Sunrise & Sunset AR",
  "short_name": "Sunar",
  "description": "A calming AR compass app for finding today's local sunrise and sunset directions.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait",
  "background_color": "#fff7ed",
  "theme_color": "#2a1518",
  "categories": ["navigation", "lifestyle", "utilities"],
  "lang": "en-US",
  "dir": "ltr",
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "./sunar-icon.webp",
      "sizes": "1254x1254",
      "type": "image/webp",
      "purpose": "any"
    },
    {
      "src": "./sunar-icon-192.webp",
      "sizes": "192x192",
      "type": "image/webp",
      "purpose": "any"
    },
    {
      "src": "./sunar-icon-512.webp",
      "sizes": "512x512",
      "type": "image/webp",
      "purpose": "any"
    },
    {
      "src": "./sunar-maskable-192.webp",
      "sizes": "192x192",
      "type": "image/webp",
      "purpose": "maskable"
    },
    {
      "src": "./sunar-maskable-512.webp",
      "sizes": "512x512",
      "type": "image/webp",
      "purpose": "maskable"
    },
    {
      "src": "./apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Open Sky Finder",
      "short_name": "Sky",
      "description": "Launch Sunar in AR sky-finder mode.",
      "url": "./",
      "icons": [
        {
          "src": "./sunar-icon-192.webp",
          "sizes": "192x192",
          "type": "image/webp"
        }
      ]
    }
  ]
}
